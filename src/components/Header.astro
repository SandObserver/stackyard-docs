---
import { inlineIcon } from '../lib/icon-set';
import { readAppVersion } from '../lib/repo';

const version = readAppVersion();
const github = await inlineIcon('github');
const appearance = await inlineIcon('appearance');
const THEMES = [
  ['auto', 'Auto'],
  ['light', 'Light'],
  ['dark', 'Dark'],
];
---

<div class="sy-bar">
  <a class="sy-brand" href="/docs/">
    <svg viewBox="146.35 105.5 772.15 816.5" width="22" height="24" aria-hidden="true" focusable="false">
      <defs><clipPath id="bar-orbit"><polygon points="512,512 -3000,-1515.65 -3000,-3000 4000,-3000 4000,4000 512,4000"></polygon></clipPath></defs>
      <g clip-path="url(#bar-orbit)"><path fill="#00D2E0" d="M512 105.5A406.5 406.5 0 0 1 864.04 715.25A75.5 75.5 0 0 1 733.27 639.75A255.5 255.5 0 0 0 512 256.5A75.5 75.5 0 0 1 512 105.5Z"></path></g>
      <path fill="currentColor" d="M551.5 443.58L264.85 278.08A79 79 0 0 0 185.85 414.92L472.5 580.42A79 79 0 0 0 551.5 443.58ZM472.5 443.58L185.85 609.08A79 79 0 0 0 264.85 745.92L551.5 580.42A79 79 0 0 0 472.5 443.58ZM433 512L433 843A79 79 0 0 0 591 843L591 512A79 79 0 0 0 433 512Z"></path>
    </svg>
    <span class="nm">Stackyard</span> <span class="sub">Docs</span>
  </a>
  <nav class="sy-links" aria-label="Site">
    <a href="/docs/" aria-current="page">Docs</a>
    <a href="https://demo.sandobserver.com" target="_blank" rel="noopener noreferrer">Demo</a>
    <a class="wide" href="/docs/changelog/">Changelog</a>
    <a class="wide" href="/docs/support/">Support</a>
    <a class="gh" href="https://github.com/SandObserver/stackyard" aria-label="GitHub">
      <svg class="sy-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" set:html={github} />
    </a>
    {version && <a class="ver wide" href="/docs/changelog/" aria-label={`Release v${version}, changelog`}>v{version}</a>}
  </nav>
  <button class="sy-theme" id="sy-theme-btn" type="button" popovertarget="sy-theme-menu" aria-label="Appearance" aria-haspopup="true" aria-expanded="false">
    <svg class="sy-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" set:html={appearance} />
  </button>
  <div class="sy-menu" id="sy-theme-menu" popover="auto" role="menu" aria-label="Appearance" tabindex="-1">
    {THEMES.map(([value, label]) => (
      <button class="sy-mi" type="button" role="menuitemradio" aria-checked="false" data-theme-value={value}>{label}</button>
    ))}
  </div>
</div>

<script>
  const btn = document.getElementById('sy-theme-btn')!;
  const menu = document.getElementById('sy-theme-menu')!;
  const items = [...menu.querySelectorAll<HTMLButtonElement>('[data-theme-value]')];
  const light = matchMedia('(prefers-color-scheme: light)');
  let byPointer = false;

  const stored = () => {
    try {
      return localStorage.getItem('starlight-theme') || 'auto';
    } catch {
      return 'auto';
    }
  };
  const mark = () => items.forEach((i) => i.setAttribute('aria-checked', String(i.dataset.themeValue === stored())));
  const resolve = (v: string) => (v === 'auto' ? (light.matches ? 'light' : 'dark') : v);

  function apply(v: string) {
    try {
      if (v === 'auto') localStorage.removeItem('starlight-theme');
      else localStorage.setItem('starlight-theme', v);
    } catch {}
    document.documentElement.dataset.theme = resolve(v);
    mark();
  }

  btn.addEventListener('click', (e) => (byPointer = e.detail > 0));
  menu.addEventListener('toggle', (e) => {
    const open = (e as ToggleEvent).newState === 'open';
    btn.setAttribute('aria-expanded', String(open));
    if (!open) return;
    mark();
    if (!CSS.supports('anchor-name: --a')) {
      const r = btn.getBoundingClientRect();
      menu.style.top = `${r.bottom}px`;
      menu.style.right = `${document.documentElement.clientWidth - r.right}px`;
    }
    (byPointer ? menu : items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
  });
  menu.addEventListener('click', (e) => {
    const item = (e.target as Element).closest<HTMLButtonElement>('[data-theme-value]');
    if (!item) return;
    apply(item.dataset.themeValue!);
    menu.hidePopover();
    btn.focus();
  });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    const i = items.indexOf(document.activeElement as HTMLButtonElement);
    items.at((i + (e.key === 'ArrowDown' ? 1 : -1)) % items.length)!.focus();
  });
  light.addEventListener('change', () => stored() === 'auto' && apply('auto'));
</script>
