---
import { manifestCard } from '../lib/widget-manifest';
import { CARD_H, RADIUS, widgetFit } from '../lib/widget-fit';

interface Item {
  type: string;
  file: string;
  id: string;
  size?: 'small' | 'medium';
  card?: 'dark' | 'graphite' | 'light' | 'translucent' | null;
  appearance?: 'dark';
  title: string;
  label?: string;
}

interface Props {
  items: Item[];
  caption?: string;
}

const { items, caption } = Astro.props;

const built = items.map((it) => {
  const size = it.size ?? 'small';
  return {
    ...it,
    size,
    ...widgetFit(size),
    src: `/widgets/${it.type}/${it.file}?id=${encodeURIComponent(it.id)}&size=${size}&lang=en`,
    declared: manifestCard(it.type, it.file),
  };
});
---

<figure class="wpv wpv--group">
  <div class="wpv__mat">
    <div class="wpv__row">
      {
        built.map((b) => (
          <div class="wpv__slot">
            <div
              class="wpv__card"
              data-card={b.card ?? b.declared.card ?? undefined}
              data-appearance={b.appearance ?? b.declared.appearance}
              style={`width:${b.w}px;height:${CARD_H}px;border-radius:${RADIUS}px;`}
            >
              <iframe
                src={b.src}
                title={b.title}
                aria-label={b.title}
                loading="lazy"
                scrolling="no"
                style={b.frameStyle}
                data-zoom={b.zoom}
              />
            </div>
            {b.label && <span class="wpv__label">{b.label}</span>}
          </div>
        ))
      }
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import '../lib/widget-zoom';
</script>
