{"appearance":"<h2 class=\"grp-hdr\" data-i18n=\"appearance.appTitle\">App Title</h2>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" id=\"rl-set-lbl-d\" data-i18n=\"appearance.showTitleDesktop\">Show App Title on Desktop</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"set-lbl-d\" aria-labelledby=\"rl-set-lbl-d\"><div class=\"tr\"></div></label></div>\n        <div class=\"row\"><span class=\"rl\" id=\"rl-set-lbl-m\" data-i18n=\"appearance.showTitleMobile\">Show App Title on Mobile</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"set-lbl-m\" aria-labelledby=\"rl-set-lbl-m\"><div class=\"tr\"></div></label></div>\n      </div>\n      <h2 class=\"grp-hdr\" data-i18n=\"appearance.display\">Display</h2>\n      <div class=\"grp\">\n        <div class=\"row\">\n          <span class=\"rl\" data-i18n=\"appearance.displayMode\">Settings Display Mode</span>\n          <div id=\"theme-slot\"></div>\n          <input type=\"hidden\" id=\"theme-sel\" value=\"system\">\n        </div>\n      </div>\n      <p class=\"grp-tip\" data-i18n=\"appearance.displayModeTip\">Sets the appearance of the Settings pages. It is stored in this browser, applies to this device only, and takes effect at once.</p>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" id=\"rl-dev-transparency\" data-i18n=\"appearance.reduceTransparency\">Reduce Transparency</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"dev-transparency\" aria-labelledby=\"rl-dev-transparency\"><div class=\"tr\"></div></label></div>\n      </div>\n      <p class=\"grp-tip\" data-i18n=\"appearance.reduceTransparencyTip\">Replaces the glass with solid surfaces on this device. It is stored in this browser and takes effect at once.</p>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" id=\"rl-set-awake\" data-i18n=\"appearance.keepAwake\">Keep Screen Awake</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"set-awake\" aria-labelledby=\"rl-set-awake\"><div class=\"tr\"></div></label></div>\n      </div>\n      <p class=\"grp-tip\" data-i18n=\"appearance.keepAwakeTip\">Stops the screen dimming or locking while the dashboard is open. Browsers only allow this over HTTPS, so it has no effect on a plain HTTP address.</p>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" id=\"rl-set-type-search\" data-i18n=\"appearance.typeToSearch\">Type to Search</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"set-type-search\" aria-labelledby=\"rl-set-type-search\"><div class=\"tr\"></div></label></div>\n      </div>\n      <p class=\"grp-tip\" data-i18n=\"appearance.typeToSearchTip\">Typing a letter anywhere on the dashboard opens search. Turn this off if search opens by accident, for example with voice control.</p>\n      <h2 class=\"grp-hdr\" data-i18n=\"appearance.wallpaper\">Wallpaper</h2>\n      <div class=\"grp\">\n        <div class=\"row\">\n          <span class=\"rl\" data-i18n=\"appearance.source\">Source</span>\n          <div id=\"bg-type-slot\"></div>\n          <input type=\"hidden\" id=\"bg-type\" value=\"unsplash\">\n        </div>\n        <div id=\"bg-unsplash-fields\">\n          <div class=\"row ie-row\" id=\"ie-apikey\"><span class=\"rl\" data-i18n=\"appearance.unsplashKey\">API Key</span><span class=\"rv\" id=\"ie-apikey-v\" data-i18n=\"common.notSet\">Not set</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button></div>\n          <div class=\"row ie-row\" id=\"ie-bgcol\"><span class=\"rl\" data-i18n=\"appearance.collectionId\">Collection ID</span><span class=\"rv is-ph\" id=\"ie-bgcol-v\" data-i18n=\"common.notSet\">Not set</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button></div>\n        </div>\n        <div id=\"bg-url-fields\" class=\"d-none\">\n          <div class=\"row\">\n            <span class=\"rl\" data-i18n=\"appearance.image\">Image</span>\n            <span class=\"rv is-ph\" id=\"bg-file-v\" data-i18n=\"appearance.noImage\">No image</span>\n            <button type=\"button\" class=\"row-btn\" id=\"bg-upload-lbl\" data-i18n=\"app.upload\">Upload</button>\n            <input type=\"file\" id=\"bg-upload\" class=\"file-hidden\" tabindex=\"-1\" aria-hidden=\"true\" accept=\"image/png,image/jpeg,image/webp,image/avif,image/gif\">\n          </div>\n          <div class=\"row ie-row\" id=\"ie-bgurl\"><span class=\"rl\" data-i18n=\"appearance.imageUrl\">Image URL</span><span class=\"rv is-ph\" id=\"ie-bgurl-v\" data-i18n=\"common.notSet\">Not set</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button></div>\n          <div class=\"row\">\n            <span class=\"rl\" data-i18n=\"appearance.fit\">Fit</span>\n            <div id=\"bg-fit-slot\"></div>\n            <input type=\"hidden\" id=\"bg-fit\" value=\"fill\">\n          </div>\n        </div>\n        <div id=\"bg-color-fields\" class=\"d-none\">\n          <div id=\"bg-color-slot\"></div>\n        </div>\n        <div class=\"row\" id=\"bg-brightness-row\">\n          <span class=\"rl\" data-i18n=\"appearance.brightness\">Brightness</span>\n          <div class=\"slider-wrap\">\n            <svg class=\"sy-icon si\" width=\"14\" height=\"14\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-bright-lo\"/></svg>\n            <input type=\"range\" id=\"bg-br\" min=\"0.1\" max=\"1.0\" step=\"0.01\" class=\"adm-range\" aria-label=\"Brightness\" data-i18n-al=\"appearance.brightness\">\n            <svg class=\"sy-icon si\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-bright-hi\"/></svg>\n          </div>\n        </div>\n      </div>\n      <p class=\"grp-tip\" id=\"bgcol-hint\" data-i18n=\"appearance.collectionTip\">Leave Collection ID blank for random.</p>\n      <p class=\"grp-tip\" id=\"bg-url-hint\" data-i18n=\"appearance.imageTip\">Uploaded and linked images are stored on this server and served from it.</p>\n    "}