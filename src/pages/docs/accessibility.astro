---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { marked } from 'marked';
import { readRepoFile, stripTitle, absolutiseLinks } from '../../lib/repo';

const REPO = 'https://github.com/SandObserver/stackyard';
const raw = readRepoFile('ACCESSIBILITY.md');

const html = raw
  ? await marked.parse(absolutiseLinks(stripTitle(raw)))
  : `<p>The accessibility statement is read from the Stackyard repository at build time, and that
     checkout was not available for this build. Read it on
     <a href="${REPO}/blob/main/ACCESSIBILITY.md">GitHub</a>.</p>`;
---

<StarlightPage
  frontmatter={{
    title: 'Accessibility',
    description:
      'How Stackyard conforms to WCAG 2.2 level AA, what is supported, and what is not yet.',
  }}
>
  <p>
    This page is generated from <code>ACCESSIBILITY.md</code> in the Stackyard repository, so it
    matches the source.
  </p>

  <Fragment set:html={html} />
</StarlightPage>
