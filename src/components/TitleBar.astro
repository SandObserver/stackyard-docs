---
import { inlineIcon } from '../lib/icon-set';

type Item = { depth: number; slug: string; text: string; children: Item[] };
const { toc, entry } = Astro.locals.starlightRoute;
const flat = (items: Item[]): Item[] => items.flatMap((i) => [i, ...flat(i.children)]);
const items = toc ? flat(toc.items as Item[]) : [];
const menuIcon = await inlineIcon('menu');
---

<div class="sy-tbar" id="sy-tbar" data-title={entry.data.title}>
  <span class="sy-tbar-t" aria-hidden="true"><span /></span>
  {
    items.length > 1 && (
      <>
        <button class="sy-otp" id="sy-otp-btn" type="button" popovertarget="sy-otp" aria-expanded="false" aria-label="On this page">
          <svg class="sy-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" set:html={menuIcon} />
          <span class="lbl">On this page</span>
        </button>
        <nav class="sy-menu sy-otp-menu" id="sy-otp" popover="auto" aria-label="On this page" tabindex="-1">
          <ul>
            {items.map((i) => (
              <li class:list={{ sub: i.depth > toc!.minHeadingLevel }}>
                <a href={`#${i.slug}`} data-slug={i.slug}>{i.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    )
  }
</div>

<script>
  const bar = document.getElementById('sy-tbar');
  const btn = document.getElementById('sy-otp-btn');
  const menu = document.getElementById('sy-otp');
  if (bar) {
    const titleBox = bar.querySelector<HTMLElement>('.sy-tbar-t')!;
    const links = menu ? [...menu.querySelectorAll<HTMLAnchorElement>('a[data-slug]')] : [];
    const heads = links
      .map((a) => document.getElementById(a.dataset.slug!))
      .filter((h): h is HTMLElement => !!h);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let byPointer = false;
    let current = '_top';
    let shown = '';

    const setTitle = (text: string, down: boolean) => {
      if (text === shown) return;
      const old = titleBox.lastElementChild as HTMLElement | null;
      for (const span of [...titleBox.children]) if (span !== old) span.remove();
      const next = Object.assign(document.createElement('span'), { textContent: text });
      shown = text;
      if (!bar.classList.contains('stuck') || !old || reduce.matches) {
        titleBox.replaceChildren(next);
        return;
      }
      next.className = down ? 'from-below' : 'from-above';
      titleBox.append(next);
      requestAnimationFrame(() => {
        old.className = down ? 'to-above' : 'to-below';
        next.className = '';
        setTimeout(() => old.remove(), 200);
      });
    };

    const update = (down = true) => {
      for (const a of links) a.toggleAttribute('aria-current', a.dataset.slug === current);
      const link = links.find((a) => a.dataset.slug === current);
      setTitle(current === '_top' ? bar.dataset.title! : link?.textContent ?? '', down);
    };

    const stuckSentinel = document.getElementById('_top');
    if (stuckSentinel) {
      new IntersectionObserver(
        ([e]) => bar.classList.toggle('stuck', !e.isIntersecting && e.boundingClientRect.top < 120),
        { rootMargin: '-104px 0px 0px 0px' },
      ).observe(stuckSentinel);
    }

    let ticking = false;
    const spy = () => {
      ticking = false;
      const line = bar.getBoundingClientRect().bottom + 16;
      let last = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top <= line) last = h;
      if (last && last.id !== current) {
        const down = heads.indexOf(last) > heads.indexOf(document.getElementById(current)!);
        current = last.id;
        update(down);
      }
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) requestAnimationFrame(spy);
        ticking = true;
      },
      { passive: true },
    );
    spy();
    update();

    if (btn && menu) {
      btn.addEventListener('click', (e) => (byPointer = e.detail > 0));
      menu.addEventListener('toggle', (e) => {
        const open = (e as ToggleEvent).newState === 'open';
        btn.setAttribute('aria-expanded', String(open));
        if (!open) return;
        if (!CSS.supports('anchor-name: --a')) {
          const r = btn.getBoundingClientRect();
          menu.style.top = `${r.bottom}px`;
          menu.style.right = `${document.documentElement.clientWidth - r.right}px`;
        }
        (byPointer ? menu : links.find((a) => a.hasAttribute('aria-current')) ?? links[0])?.focus({ preventScroll: true });
      });
      menu.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) menu.hidePopover();
      });
      menu.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const i = links.indexOf(document.activeElement as HTMLAnchorElement);
        links.at((i + (e.key === 'ArrowDown' ? 1 : -1)) % links.length)!.focus();
      });
    }
  }
</script>
