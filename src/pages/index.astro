---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { iconSprite } from '../lib/icon-set';
import { readAppVersion } from '../lib/repo';

const version = readAppVersion();

const guide = readFileSync(resolve(process.cwd(), 'src/content/docs/docs/installation/docker.mdx'), 'utf8');
const composeBlock = guide.match(/## Compose\n+```yaml\n([\s\S]*?)\n```\n+```sh\n([\s\S]*?)\n```/);
const runBlock = guide.match(/## docker run\n+```sh\n([\s\S]*?)\n```/);
if (!composeBlock || !runBlock) throw new Error('docker.mdx: the Compose or docker run block moved. Update the Get started parser.');
const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
const markValues = (t: string) => esc(t)
  .replace(/(?<=&quot;|-p )8700(?=:80)/g, '<span class="v">8700</span>')
  .replace(/\.\/(data|icons)(?=:\/)/g, '<span class="v">./$1</span>');
const install = {
  compose: { fname: 'compose.yml', code: markValues(composeBlock[1]), start: esc(composeBlock[2]) },
  run: { fname: 'Terminal', code: markValues(runBlock[1]), start: '' },
  unraid: { fname: 'Unraid', code: esc('Apps tab › search "Stackyard" › Install'), start: '' },
  truenas: { fname: 'TrueNAS', code: esc('Apps › Discover Apps › search "Stackyard" › Install'), start: '' },
};
const sprite = await iconSprite(['external', 'general']);
const iconMasks = sprite.match(/<defs>([\s\S]*?)<\/defs>/)?.[1] ?? '';
const stepIcon = (id: string) => {
  const body = sprite.match(new RegExp(`<symbol id="sy-solid-${id}" viewBox="0 0 24 24">([\\s\\S]*?)</symbol>`))?.[1] ?? '';
  return `<svg class="si" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${body}</svg>`;
};
const icons = { external: stepIcon('external'), general: stepIcon('general') };
const installJson = JSON.stringify({ install, icons }).replace(/</g, '\\u003c');

const title = 'Stackyard: a homelab dashboard you\'ll actually use';
const description =
  'A calm, customizable dashboard for the services you self-host. Open source, runs in Docker, and useful without becoming another wall of data.';

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const canonical = `${site}/`;
const ogImage = `${site}/img/og-2f94d569.jpg`;

const publisher = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Stackyard',
  url: `${site}/`,
  logo: `${site}/img/stackyard-wordmark-dark-4680834d.svg`,
  sameAs: ['https://github.com/SandObserver/stackyard'],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    publisher,
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'Stackyard',
      url: `${site}/`,
      description,
      publisher: { '@id': `${site}/#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#software`,
      name: 'Stackyard',
      description,
      url: canonical,
      image: ogImage,
      applicationCategory: 'BrowserApplication',
      applicationSubCategory: 'Self-hosted homelab dashboard',
      operatingSystem: 'Docker, Linux, Windows, macOS',
      ...(version ? { softwareVersion: version } : {}),
      downloadUrl: `${site}/docs/installation/docker/`,
      installUrl: `${site}/docs/installation/docker/`,
      releaseNotes: `${site}/docs/changelog/`,
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      softwareHelp: `${site}/docs/`,
      codeRepository: 'https://github.com/SandObserver/stackyard',
      publisher: { '@id': `${site}/#organization` },
      author: { '@type': 'Person', name: 'SandObserver', url: 'https://github.com/SandObserver' },
    },
  ],
};
