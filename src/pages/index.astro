    .gs .code-bar{display:flex;justify-content:space-between;align-items:center;padding:4px 6px 4px 16px;border-bottom:1px solid var(--separator-opaque);
      font-family:var(--font-mono);font-size:12.5px;color:var(--a11y-dim)}
    .gs .copy{position:relative;height:30px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:var(--label-primary);
      font:600 13px var(--font-ui);cursor:pointer;transition:background-color .2s ease,transform .15s ease}
    .gs .copy{display:inline-grid;place-items:center}
    .gs .copy>span{grid-area:1/1;transition:opacity .1s ease}
    .gs .copy>span+span,.gs .copy.done>span:first-child{opacity:0}
