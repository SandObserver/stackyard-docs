{"security":"<h2 class=\"grp-hdr\" data-i18n=\"general.security\">Security</h2>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" id=\"rl-sec-en\" data-i18n=\"general.passwordProtection\">Password Protection</span><label class=\"tog\"><input type=\"checkbox\" role=\"switch\" id=\"sec-en\" aria-labelledby=\"rl-sec-en\"><div class=\"tr\"></div></label></div>\n        <div class=\"row-wrap reveal\" id=\"ie-pw-wrap\"><div class=\"reveal-in\"><div class=\"row ie-row\" id=\"ie-pw\"><span class=\"rl\" data-i18n=\"general.password\">Password</span><span class=\"rv is-ph\" id=\"ie-pw-v\" data-i18n=\"common.notSet\">Not set</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button><button class=\"pw-reveal\" type=\"button\" aria-pressed=\"false\" aria-label=\"Show password\" title=\"Show password\" data-i18n-al=\"common.showPassword\" data-i18n-title=\"common.showPassword\"><svg class=\"sy-icon\" width=\"18\" height=\"18\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-eye\"/></svg></button></div></div></div>\n        <div class=\"row-wrap reveal\" id=\"ie-pw2-wrap\"><div class=\"reveal-in\"><div class=\"row ie-row\" id=\"ie-pw2\"><span class=\"rl\" data-i18n=\"general.confirmPassword\">Confirm Password</span><span class=\"rv is-ph\" id=\"ie-pw2-v\" data-i18n=\"common.notSet\">Not set</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button><button class=\"pw-reveal\" type=\"button\" aria-pressed=\"false\" aria-label=\"Show password\" title=\"Show password\" data-i18n-al=\"common.showPassword\" data-i18n-title=\"common.showPassword\"><svg class=\"sy-icon\" width=\"18\" height=\"18\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-eye\"/></svg></button></div></div></div>\n        <div class=\"row-wrap reveal\" id=\"sec-revoke-wrap\"><div class=\"reveal-in\"><div class=\"row\" id=\"sec-revoke-row\"><span class=\"rl\" data-i18n=\"general.signOutEverywhere\">Sign Out All Devices</span><div class=\"row-btns\"><button class=\"btn bg sm\" id=\"sec-revoke\" type=\"button\" data-i18n=\"general.signOutEverywhereBtn\">Sign out all</button></div></div></div></div>\n      </div>\n      <div id=\"sec-pw-bars\" class=\"pw-bars d-none\" aria-hidden=\"true\"><div class=\"pwbar\"></div><div class=\"pwbar\"></div><div class=\"pwbar\"></div><div class=\"pwbar\"></div><div class=\"pwbar\"></div></div>\n      <div id=\"sec-pw-hint\" class=\"pw-hint d-none\" role=\"status\"></div>\n      <div class=\"reveal\" id=\"revoke-tip-wrap\"><div class=\"reveal-in\"><p class=\"grp-tip\" id=\"revoke-tip\" data-i18n=\"general.signOutEverywhereTip\">Signs out every browser and device, including this one. Use it if you think a session may have been left open or compromised. Your password does not change.</p></div></div>\n      <div class=\"reveal\" id=\"pw-hint-wrap\"><div class=\"reveal-in\"><p class=\"grp-tip\" id=\"pw-hint-static\" data-i18n-html=\"general.passwordTip\">Leave blank to keep existing password. Min 15 characters. For stronger protection, consider placing the dashboard behind a <strong>dedicated authentication proxy</strong>. This built-in password is a lightweight gate, not a full authentication layer.</p></div></div>\n      <div class=\"grp\">\n        <div class=\"row ie-row\" id=\"ie-hosts\"><span class=\"rl\" data-i18n=\"general.allowedHosts\">Allowed Addresses</span><span class=\"rv is-ph\" id=\"ie-hosts-v\" data-i18n=\"general.allowedHostsNone\">Local addresses only</span><button class=\"pe\" type=\"button\"><svg class=\"sy-icon\" width=\"17\" height=\"17\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-edit\"/></svg></button></div>\n        <div class=\"row-wrap reveal\" id=\"hosts-add-wrap\"><div class=\"reveal-in\"><div class=\"row\"><span class=\"rl\" id=\"hosts-add-name\"></span><div class=\"row-btns\"><button class=\"btn bg sm\" id=\"hosts-add\" type=\"button\" aria-describedby=\"hosts-add-tip\" data-i18n=\"common.add\">+ Add</button></div></div></div></div>\n      </div>\n      <div class=\"reveal\" id=\"hosts-add-tip-wrap\"><div class=\"reveal-in\"><p class=\"grp-tip\" id=\"hosts-add-tip\" data-i18n=\"general.allowedHostsAddTip\">This page is open on an address that isn’t listed. Add it so a page on another site can’t use up your sign-in attempts.</p></div></div>\n      <p class=\"grp-tip\" data-i18n-html=\"general.allowedHostsTip\">While no password is set, Stackyard answers only on IP addresses, local names such as <code>nas</code> or <code>nas.local</code>, and the addresses listed here. Separate them with commas.</p>\n\n      ","backup":"<h2 class=\"grp-hdr\" data-i18n=\"general.backup\">Backup</h2>\n      <div class=\"grp\">\n        <div class=\"row\"><span class=\"rl\" data-i18n=\"general.importExport\">Import / Export</span><div class=\"row-btns\"><label class=\"btn bg sm cursor-ptr\"><span data-i18n=\"common.import\">Import</span><input type=\"file\" id=\"imp\" accept=\".json\" class=\"file-hidden\" aria-label=\"Import configuration JSON\" data-i18n-al=\"general.importJson\"></label><button class=\"btn bg sm\" id=\"btn-exp\" type=\"button\" data-i18n=\"common.export\">Export</button></div></div>\n        <div class=\"row\"><span class=\"rl\" data-i18n=\"general.importForeign\">Import from Another Dashboard</span><div class=\"row-btns\"><label class=\"btn bg sm cursor-ptr\"><span data-i18n=\"common.chooseFiles\">Choose Files</span><input type=\"file\" id=\"imp-foreign\" accept=\".yml,.yaml\" multiple class=\"file-hidden\" aria-label=\"Import Homepage or Dashy YAML config\" data-i18n-al=\"general.importForeignFiles\"></label></div></div>\n        <div class=\"row\"><span class=\"rl\" id=\"rl-imp-docker\" data-i18n=\"general.importDocker\">Import from Docker Labels</span><div class=\"row-btns\"><button class=\"btn bg sm\" id=\"btn-imp-docker\" type=\"button\" aria-labelledby=\"rl-imp-docker\" data-i18n=\"common.import\">Import</button></div></div>\n      </div>\n      <p class=\"grp-tip\" data-i18n=\"general.importForeignTip\">Reads gethomepage and Dashy YAML files, and gethomepage labels on your containers through the Docker Socket URL. Links and folders are added to your dashboard; widgets from the other dashboard become plain links.</p>\n      ","about":"<div class=\"about-hero\">\n        <div class=\"about-ic-wrap\">\n          <svg class=\"sy-icon brand-logo\" width=\"64\" height=\"64\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><defs><clipPath id=\"about-orbit-clip\"><polygon points=\"12,12 -70.31,-35.52 -70.31,-70.31 93.75,-70.31 93.75,93.75 12,93.75\"/></clipPath></defs><g clip-path=\"url(#about-orbit-clip)\"><use class=\"about-orbit\" href=\"#sy-solid-logo-arc\"/></g><use href=\"#sy-solid-logo-ink\"/></svg>\n          <div class=\"about-dot d-none\" id=\"about-update-dot\" title=\"Update available\" data-i18n-title=\"about.updateAvailable\">\n            <svg class=\"sy-icon\" width=\"10\" height=\"10\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-up\"/></svg>\n          </div>\n        </div>\n        <div class=\"about-name\">Stackyard</div>\n        <div class=\"about-ver\" id=\"about-version\">Version</div>\n      </div>\n      <div class=\"grp\">\n        <a class=\"row row-link\" href=\"https://stackyard.sandobserver.com/docs/\" target=\"_blank\" rel=\"noopener\"><svg class=\"sy-icon about-ri about-docs\" width=\"15\" height=\"15\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-docs\"/></svg><span class=\"rl\" data-i18n=\"about.documentation\">Documentation</span><svg class=\"sy-icon about-ext\" width=\"12\" height=\"12\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-external\"/></svg></a>\n        <a class=\"row row-link\" href=\"https://github.com/SandObserver/stackyard/issues\" target=\"_blank\" rel=\"noopener\"><svg class=\"sy-icon about-ri about-bug\" width=\"15\" height=\"15\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-bug\"/></svg><span class=\"rl\" data-i18n=\"about.reportIssue\">Report an Issue</span><svg class=\"sy-icon about-ext\" width=\"12\" height=\"12\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-external\"/></svg></a>\n        <a class=\"row row-link\" href=\"https://github.com/SandObserver/stackyard/tree/main\" target=\"_blank\" rel=\"noopener\"><svg class=\"sy-icon about-ri\" width=\"15\" height=\"15\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-github\"/></svg><span class=\"rl\" data-i18n=\"about.sourceCode\">Source Code</span><svg class=\"sy-icon about-ext\" width=\"12\" height=\"12\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-external\"/></svg></a>\n        <a class=\"row row-link\" href=\"https://stackyard.sandobserver.com/docs/support/\" target=\"_blank\" rel=\"noopener\"><svg class=\"sy-icon about-ri about-heart\" width=\"15\" height=\"15\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-heart\"/></svg><span class=\"rl\" data-i18n=\"about.support\">Support</span><svg class=\"sy-icon about-ext\" width=\"12\" height=\"12\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#sy-solid-external\"/></svg></a>\n      </div>\n    ","version":"v1.23.0"}