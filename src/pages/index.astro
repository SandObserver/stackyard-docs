          <span class="mdup" aria-hidden="true"><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-plex.svg" alt=""><span class="mname">Plex</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-jellyfin.svg" alt=""><span class="mname">Jellyfin</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-emby.svg" alt=""><span class="mname">Emby</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-navidrome.svg" alt=""><span class="mname">Navidrome</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-audiobookshelf.svg" alt=""><span class="mname">Audiobookshelf</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-komga.svg" alt=""><span class="mname">Komga</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-kavita.svg" alt=""><span class="mname">Kavita</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-github.svg" alt=""><span class="mname">GitHub</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-adguard-home.svg" alt=""><span class="mname">AdGuard Home</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-pi-hole.svg" alt=""><span class="mname">Pi-hole</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-technitium.svg" alt=""><span class="mname">Technitium</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-nextdns.svg" alt=""><span class="mname">NextDNS</span></span></span>
        </div>
        <div class="mrow mrow-b">
          <span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-glances.svg" alt=""><span class="mname">Glances</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-beszel.svg" alt=""><span class="mname">Beszel</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-unraid.svg" alt=""><span class="mname">Unraid</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-scrutiny.svg" alt=""><span class="mname">Scrutiny</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-truenas-scale.svg" alt=""><span class="mname">TrueNAS</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-duplicati.svg" alt=""><span class="mname">Duplicati</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-kopia.svg" alt=""><span class="mname">Kopia</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-gluetun.svg" alt=""><span class="mname">Gluetun</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-conduit.svg" alt=""><span class="mname">Psiphon Conduit</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-netbird.svg" alt=""><span class="mname">NetBird</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-plausible.svg" alt=""><span class="mname">Plausible</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-umami.svg" alt=""><span class="mname">Umami</span></span><span class="mitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3.4"/><path d="M9 2.6v1.7M9 13.7v1.7M3.5 9H1.8M16.2 9h-1.7M5.1 5.1 3.9 3.9M14.1 14.1l-1.2-1.2M12.9 5.1l1.2-1.2M3.9 14.1l1.2-1.2"/><path d="M17.5 21.5H8.8a3.9 3.9 0 0 1-.4-7.8 5 5 0 0 1 9.5.9 3.4 3.4 0 0 1-.4 6.9Z"/></svg><sp