          <span class="mdup" aria-hidden="true"><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-glances.svg" alt=""><span class="mname">Glances</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-beszel.svg" alt=""><span class="mname">Beszel</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-unraid.svg" alt=""><span class="mname">Unraid</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-scrutiny.svg" alt=""><span class="mname">Scrutiny</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-truenas-scale.svg" alt=""><span class="mname">TrueNAS</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-duplicati.svg" alt=""><span class="mname">Duplicati</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-kopia.svg" alt=""><span class="mname">Kopia</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-gluetun.svg" alt=""><span class="mname">Gluetun</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-conduit.svg" alt=""><span class="mname">Psiphon Conduit</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-netbird.svg" alt=""><span class="mname">NetBird</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-plausible.svg" alt=""><span class="mname">Plausible</span></span><span class="mitem"><img loading="lazy" decoding="async" src="/icons/w-umami.svg" alt=""><span class="mname">Umami</span></span><span class="mitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="3.4"/><path d="M9 2.6v1.7M9 13.7v1.7M3.5 9H1.8M16.2 9h-1.7M5.1 5.1 3.9 3.9M14.1 14.1l-1.2-1.2M12.9 5.1l1.2-1.2M3.9 14.1l1.2-1.2"/><path d="M17.5 21.5H8.8a3.9 3.9 0 0 1-.4-7.8 5 5 0 0 1 9.5.9 3.4 3.4 0 0 1-.4 6.9Z"/></svg><span class="mname">Weather</span></span></span>
        </div>
      </div>
    </div>

    <div class="feature">
      <div class="ftext">
        <h2>No configuration files required</h2>
        <p>Add apps, configure widgets, set up badges, and arrange your layout, all from the admin UI. There is no YAML to hand-edit. Export your setup for a backup, import it to move to a new machine.</p>
      </div>
      <div class="fvis">
        <div class="admin" role="img" aria-label="The Stackyard admin dashboard list">
          <div class="achips">
            <span class="achip on">All</span>
            <span class="achip">Apps</span>
            <span class="achip">Widgets</span>
            <span class="achip">Folders</span>
          </div>
          <div class="arows">
            <div class="arow">
              <svg class="ahandle" viewBox="0 0 24 24" aria-hidden="true"><g><circle cx="9" cy="6" r="2" fill="currentColor"/><circle cx="15" cy="6" r="2" fill="currentColor"/><circle cx="9" cy="12" r="2" fill="currentColor"/><circle cx="15" cy="12" r="2" fill="currentColor"/><circle cx="9" cy="18" r="2" fill="currentColor"/><circle cx="15" cy="18" r="2" fill="currentColor"/></g><g></g></svg>
              <span class="aicon" style="background:#1c1c1e"><img src="/icons/w-github.svg" alt=""></span>
              <span class="aname">GitHub</span>
              <span class="apills">
                <span class="apill" style="background:rgba(109,124,255,.20);color:#B7B9FF">Dock</span>
                <span class="apill" style="background:rgba(0,145,255,.20);color:#79C5FF">Badge</span>
                <span class="apill" style="background:rgba(255,55,95,.20);color:#FF9FCF">Health</span>
