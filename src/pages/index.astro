<section class="gs-band" id="get-started" aria-labelledby="gs-title">
  <svg class="sy-sprite" width="0" height="0" aria-hidden="true" focusable="false"><defs set:html={iconMasks} /><symbol id="i-chevrons" viewBox="0 0 24 24"><path d="M8 9l4-4 4 4M8 15l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol></svg>
  <div class="wrap setup-grid pop-root">
    <div class="setup-side">
      <h2 id="gs-title">Get started</h2>
      <p class="lede">Free and open source. Runs in Docker on 64-bit Intel, AMD and ARM.</p>
    </div>
    <div class="gs" id="gs">
      <p class="sentence">I run containers with <button class="pop" type="button" aria-haspopup="listbox" aria-expanded="false" data-k="method" aria-label="Install method: Docker Compose"><span>Docker Compose</span><svg aria-hidden="true"><use href="#i-chevrons"/></svg></button>.</p>
      <div class="code" id="g-code"><div class="code-bar"><span class="fname">{install.compose.fname}</span><button type="button" class="copy" aria-label="Copy the install file"><span>Copy</span><span aria-hidden="true">Copied</span></button></div><pre tabindex="0" role="region" aria-label="Install file"><code class="out" set:html={install.compose.code} /></pre></div>
      <div class="code" id="g-start"><div class="code-bar"><span>Start it</span><button type="button" class="copy" aria-label="Copy the start command"><span>Copy</span><span aria-hidden="true">Copied</span></button></div><pre tabindex="0" role="region" aria-label="Start command"><code class="out" set:html={install.compose.start} /></pre></div>
      <ul class="ilist" id="g-next">
        <li><div class="irow"><Fragment set:html={icons.external} /><span class="imain"><span class="iname">Open <code>http://&lt;server-ip&gt;:8700</code></span><span class="itext">You can set a password on the first visit, or skip it.</span></span></div></li>
        <li><div class="irow"><Fragment set:html={icons.general} /><span class="imain"><span class="iname">Set it up in Settings</span><span class="itext">Add apps, folders, badges and widgets, or import a backup or another dashboard's config.</span></span></div></li>
      </ul>
      <p class="list-foot">Variables, reverse proxies and backups: <a href="/docs/installation/docker/">Full setup guide<span aria-hidden="true"> ›</span></a></p>
    </div>
  </div>
  <p class="sr-only" id="gs-live" aria-live="polite"></p>
  <script type="application/json" id="install-data" is:inline set:html={installJson} />
  <script is:inline>
{
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const { install, icons } = JSON.parse($('#install-data').textContent);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const live = $('#gs-live');
  const say = (text) => { live.textContent = ''; requestAnimationFrame(() => (live.textContent = text)); };
  const store = {
    get(k) { try { return JSON.parse(localStorage.getItem(k)); } catch { return null; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
  };
  const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const methods = { compose: 'Docker Compose', run: 'docker run', unraid: 'Unraid', truenas: 'TrueNAS' };
  const row = (icon, name, text) => `<li><div class="irow">${icons[icon]}<span class="imain"><span class="iname">${name}</span><span class="itext">${text}</span></span></div></li>`;
  const next = (m) =>
    row('external', m === 'unraid' ? 'Click WebUI in the Docker tab' : m === 'truenas' ? "Click Web UI on the app's page" : 'Open <code>http://&lt;server-ip&gt;:8700</code>', 'You can set a password on the first visit, or skip it.')
    + row('general', 'Set it up in Settings', "Add apps, folders, badges and widgets, or import a backup or another dashboard's config.");

  let reserve = 0;
  const setReserve = (px) => {
    reserve = Math.max(0, Math.round(px));
    document.body.style.paddingBottom = reserve ? `${reserve}px` : '';
  };
  addEventListener('scroll', () => {
    if (!reserve) return;
    const spare = document.documentElement.scrollHeight - scrollY - innerHeight;
    if (spare > 0) setReserve(reserve - spare);
  }, { passive: true });

  let morphRun = null;
  function morph(el, anchor, mutate, animate = true) {
    const parts = () => $$('.code:not([hidden]), .ilist > li', el).map((n) => [n.id || `li${[...n.parentNode.children].indexOf(n)}`, n]);
    const before = new Map(parts().map(([k, n]) => [k, n.textContent]));
    const from = el.offsetHeight;
    morphRun?.cancel();
    morphRun = null;
    el.classList.remove('morphing');
    const top = anchor.getBoundingClientRect().top;
    setReserve(reserve + from);
    mutate();
    const to = el.offsetHeight;
    setReserve(scrollY + innerHeight - (document.documentElement.scrollHeight - reserve));
    scrollBy(0, anchor.getBoundingClientRect().top - top);
    if (!animate || reduce.matches || from === to) return;
    const duration = Math.min(300, 200 + Math.abs(to - from) / 4);
    el.classList.add('morphing');
    morphRun = el.animate({ height: [`${from}px`, `${to}px`] }, { duration, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' });
    morphRun.onfinish = () => { morphRun = null; el.classList.remove('morphing'); };
    for (const [k, n] of parts()) {
      if (before.get(k) === n.textContent || $('.chg', n)) continue;
      n.animate({ opacity: [0, 1] }, { duration: duration * 0.5, delay: duration * 0.12, easing: 'linear', fill: 'backwards' });
    }
  }

  let openMenu = null;
  function closeMenu(refocus) {
    if (!openMenu) return;
    const { list, btn } = openMenu;
    list.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
    btn.removeAttribute('aria-controls');
    setTimeout(() => list.remove(), 160);
    if (refocus) btn.focus({ preventScroll: true });
    openMenu = null;
  }
  function placePill(list, li) {
    const pill = $('.mp', list);
    if (!li) { pill.classList.remove('on'); return; }
    pill.style.width = `${li.offsetWidth}px`;
    pill.style.height = `${li.offsetHeight}px`;
    pill.style.transform = `translate3d(${li.offsetLeft}px, ${li.offsetTop}px, 0)`;
    if (!pill.classList.contains('on')) { pill.getBoundingClientRect(); pill.classList.add('on'); }
  }
  function showMenu(btn, { label, options, selected, onPick }) {
    if (openMenu?.btn === btn) { closeMenu(true); return; }
    closeMenu();
    const root = btn.closest('.pop-root');
    const list = document.createElement('div');
    list.className = 'menu';
    list.id = 'gs-menu';
    list.setAttribute('role', 'listbox');
    list.setAttribute('aria-label', label);
    list.innerHTML = '<div class="mp" aria-hidden="true"></div>' + options.map((o) =>
      `<div role="option" tabindex="-1" data-v="${esc(o.v)}" aria-selected="${o.v === selected}">${esc(o.label)}</div>`).join('');
    root.append(list);
    const opts = $$('[role=option]', list);
    const rr = root.getBoundingClientRect(), br = btn.getBoundingClientRect();
    const left = Math.min(Math.max(8, br.left - rr.left), rr.width - list.offsetWidth - 8);
    list.style.left = `${left}px`;
    list.style.top = `${br.bottom - rr.top + 6}px`;
    list.style.transformOrigin = `${Math.max(16, Math.min(list.offsetWidth - 16, br.left - rr.left - left + br.width / 2))}px -6px`;
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-controls', list.id);
    requestAnimationFrame(() => list.classList.add('open'));
    openMenu = { list, btn };
    let active = Math.max(0, opts.findIndex((o) => o.dataset.v === selected));
    const setActive = (i) => { active = (i + opts.length) % opts.length; opts[active].focus({ preventScroll: true }); placePill(list, opts[active]); };
    const choose = (o) => { closeMenu(true); onPick(o.dataset.v); };
    opts.forEach((o) => {
      o.addEventListener('pointerenter', () => placePill(list, o));
      o.addEventListener('click', () => choose(o));
    });
    list.addEventListener('pointerleave', () => placePill(list, document.activeElement?.closest?.('.menu [role=option]')));
    list.addEventListener('focusout', (e) => { if (!list.contains(e.relatedTarget) && e.relatedTarget !== btn) closeMenu(); });
    let typed = '', typedAt = 0;
    list.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
      else if (e.key === 'End') { e.preventDefault(); setActive(opts.length - 1); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(opts[active]); }
      else if (e.key === 'Escape') { e.preventDefault(); closeMenu(true); }
      else if (e.key === 'Tab') closeMenu(true);
      else if (e.key.length === 1) {
        const now = Date.now();
        typed = now - typedAt > 800 ? e.key.toLowerCase() : typed + e.key.toLowerCase();
        typedAt = now;
        const hit = opts.findIndex((o) => o.textContent.toLowerCase().startsWith(typed));
        if (hit >= 0) setActive(hit);
      }
    });
    requestAnimationFrame(() => setActive(active));
  }
  document.addEventListener('pointerdown', (e) => { if (openMenu && !openMenu.list.contains(e.target) && !openMenu.btn.contains(e.target)) closeMenu(); });
  addEventListener('resize', () => closeMenu());

  const saved = store.get('stackyard-install');
  let method = methods[saved?.method] ? saved.method : 'compose';
  const plain = (html) => { const t = document.createElement('template'); t.innerHTML = html; return t.content.textContent; };
  const highlight = (oldText, html) => {
    const old = new Set(oldText.split('\n'));
    return html.split('\n').map((line) => (old.has(plain(line)) ? line : `<span class="chg">${line}</span>`)).join('\n');
  };
  const pop = $('#gs .pop');
  function draw(animate) {
    const view = install[method];
    const code = $('#g-code .out'), oldText = code.textContent, sameFile = $('#g-code .fname').textContent === view.fname;
    morph($('#gs'), pop, () => {
      $('#g-code .fname').textContent = view.fname;
      code.innerHTML = animate && sameFile ? highlight(oldText, view.code) : view.code;
      $('#g-start').hidden = !view.start;
      $('#g-start .out').innerHTML = view.start;
      $('#g-next').innerHTML = next(method);
      $('span', pop).textContent = methods[method];
      pop.setAttribute('aria-label', `Install method: ${methods[method]}`);
    }, animate);
    if (animate) say(`Install steps now show ${methods[method]}.`);
  }
  const open = () => showMenu(pop, {
    label: 'Install method',
    options: Object.entries(methods).map(([v, label]) => ({ v, label })),
    selected: method,
    onPick: (v) => { if (v === method) return; method = v; store.set('stackyard-install', { method }); draw(true); },
  });
  pop.addEventListener('click', (e) => { e.stopPropagation(); open(); });
  pop.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); } });
  if (method !== 'compose') draw(false);

  async function copyText(code) {
    try { await navigator.clipboard.writeText(code.textContent); }
    catch {
      getSelection().selectAllChildren(code);
      const copied = document.execCommand('copy');
      getSelection().removeAllRanges();
      if (!copied) throw new Error('copy refused');
    }
  }
  for (const button of $$('#gs .copy')) {
    button.addEventListener('click', async () => {
      const code = button.closest('.code').querySelector('code');
      try {
        await copyText(code);
        button.classList.add('done');
        live.textContent = `Copied ${button.getAttribute('aria-label').replace(/^Copy /, '')}`;
        clearTimeout(button.doneTimer);
        button.doneTimer = setTimeout(() => { button.classList.remove('done'); live.textContent = ''; }, 1500);
      } catch { getSelection().selectAllChildren(code); }
    });
  }
}
  </script>
</section>

