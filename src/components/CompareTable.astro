---
interface Row {
  label: string;
  values: [string, string, string, string];
  /* 1-based index into `footnotes`, marked on the Stackyard cell. */
  cellNote?: number;
  /* 1-based index into `footnotes`, marked on the row label. */
  labelNote?: number;
}

interface Props {
  rows: Row[];
  rivals: string[];
  /* Rendered as HTML so a note can link. Authored here, never user input. */
  footnotes: string[];
}

const { rows, rivals, footnotes } = Astro.props;
const names = ['Stackyard', ...rivals];
---

<div class="sy-cmp not-content">
  <table class="sy-cmp__t">
    <caption class="sy-cmp__sr">Stackyard compared with {rivals.join(', ')}</caption>
    <thead>
      <tr>
        <th scope="col"><span class="sy-cmp__sr">Feature</span></th>
        {names.map((name, i) => <th scope="col" class={i === 0 ? 'sy-cmp__own' : undefined}>{name}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">
            {row.label}
            {row.labelNote && (
              <a class="sy-cmp__mark" href={`#sy-fn-${row.labelNote}`}>
                <sup>{row.labelNote}</sup>
                <span class="sy-cmp__sr">See note {row.labelNote}</span>
              </a>
            )}
          </th>
          {row.values.map((value, i) => (
            <td class={i === 0 ? 'sy-cmp__own' : undefined}>
              {value}
              {i === 0 && row.cellNote && (
                <a class="sy-cmp__mark" href={`#sy-fn-${row.cellNote}`}>
                  <sup>{row.cellNote}</sup>
                  <span class="sy-cmp__sr">See note {row.cellNote}</span>
                </a>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  <div class="sy-cmp__list">
    {rows.map((row, g) => (
      <section class="sy-cmp__group" aria-labelledby={`sy-cmp-g${g}`}>
        <p class="sy-cmp__gh" id={`sy-cmp-g${g}`}>
          {row.label}
          {row.labelNote && (
            <a class="sy-cmp__mark" href={`#sy-fn-${row.labelNote}`}>
              <sup>{row.labelNote}</sup>
              <span class="sy-cmp__sr">See note {row.labelNote}</span>
            </a>
          )}
        </p>
        <dl class="sy-cmp__rows">
          {row.values.map((value, i) => (
            <div class:list={['sy-cmp__row', { 'sy-cmp__own': i === 0 }]}>
              <dt>{names[i]}</dt>
              <dd>
                {value}
                {i === 0 && row.cellNote && (
                  <a class="sy-cmp__mark" href={`#sy-fn-${row.cellNote}`}>
                    <sup>{row.cellNote}</sup>
                    <span class="sy-cmp__sr">See note {row.cellNote}</span>
                  </a>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>

  <details class="sy-cmp__notes">
    <summary>Sources and notes</summary>
    <ol>
      {footnotes.map((text, i) => <li id={`sy-fn-${i + 1}`} set:html={text} />)}
    </ol>
  </details>
</div>

<script>
  const openNotesFor = (hash: string) => {
    if (!/^#sy-fn-\d+$/.test(hash)) return;
    const note = document.querySelector(hash);
    const details = note?.closest('details');
    if (details && !details.open) details.open = true;
  };

  document.addEventListener('click', (e) => {
    const mark = (e.target as Element).closest?.('a.sy-cmp__mark');
    if (mark) openNotesFor(mark.getAttribute('href') ?? '');
  });
  openNotesFor(location.hash);
</script>

<style>
  .sy-cmp {
    container-type: inline-size;
    margin: 20px 0 24px;
  }

  .sy-cmp .sy-cmp__t {
    display: table;
    width: 100%;
    margin: 0;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    background: none;
    border-radius: 0;
    overflow: visible;
    font-size: 15px;
    line-height: 1.3333;
    letter-spacing: -0.0153em;
  }

  .sy-cmp .sy-cmp__t th,
  .sy-cmp .sy-cmp__t td {
    padding: 12px 10px;
    border: 0;
    background: none;
    text-align: center;
    vertical-align: middle;
    font-weight: 400;
    color: var(--sy-dim);
  }

  .sy-cmp .sy-cmp__t thead th {
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    font-weight: 600;
    color: var(--sy-tx);
  }

  .sy-cmp .sy-cmp__t tbody th {
    width: 24%;
    font-size: 15px;
    letter-spacing: -0.0153em;
    padding-inline-start: 0;
    text-align: start;
    color: var(--sy-tx);
  }

  .sy-cmp .sy-cmp__t tbody > tr > * {
    box-shadow: inset 0 1px var(--sy-row-sep);
  }

  .sy-cmp .sy-cmp__t .sy-cmp__own {
    background: color-mix(in srgb, var(--sy-accent) 10%, transparent);
    color: var(--sy-tx);
    font-weight: 600;
  }

  .sy-cmp .sy-cmp__t thead .sy-cmp__own {
    border-start-start-radius: 14px;
    border-start-end-radius: 14px;
  }

  .sy-cmp .sy-cmp__t tbody tr:last-child .sy-cmp__own {
    border-end-start-radius: 14px;
    border-end-end-radius: 14px;
  }

  .sy-cmp__list {
    display: none;
  }

  .sy-cmp__group {
    padding: 12px;
    border: 1px solid var(--sy-row-sep);
    border-radius: 12px;
  }

  .sy-cmp__group + .sy-cmp__group {
    margin-top: 6px;
  }

  .sy-cmp__gh {
    margin: 0 0 8px;
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    font-weight: 600;
    color: var(--sy-tx);
  }

  .sy-cmp__rows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 12px;
    margin: 0;
  }

  .sy-cmp__row dt {
    font-size: 12px;
    line-height: 1.3333;
    color: var(--sy-dim);
  }

  .sy-cmp__row dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.3333;
    letter-spacing: -0.0153em;
    color: var(--sy-dim);
  }

  .sy-cmp__row.sy-cmp__own dd {
    color: var(--sy-tx);
    font-weight: 600;
  }

  @container (max-width: 520px) {
    .sy-cmp .sy-cmp__t {
      display: none;
    }
    .sy-cmp__list {
      display: block;
    }
  }

  .sy-cmp__mark {
    text-decoration: none;
    font-weight: 400;
    color: var(--sl-color-text-accent);
  }

  .sy-cmp__mark sup {
    font-size: 11px;
    line-height: 1;
    padding-inline-start: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sy-cmp__mark:hover sup {
      text-decoration: underline;
    }
  }

  .sy-cmp__notes {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    color: var(--sy-dim);
  }

  .sy-cmp__notes summary {
    display: flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    min-height: 44px;
    border-radius: 8px;
    list-style: none;
    cursor: pointer;
    color: var(--sy-dim);
    transition: color 150ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .sy-cmp__notes summary::-webkit-details-marker {
    display: none;
  }

  .sy-cmp__notes summary::after {
    content: '';
    width: 6px;
    height: 6px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .sy-cmp__notes[open] summary::after {
    transform: translateY(1px) rotate(-135deg);
  }

  .sy-cmp__notes[data-sy-closing='true'] summary::after {
    transform: translateY(-2px) rotate(45deg);
    transition-duration: 160ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .sy-cmp__notes summary:hover {
      color: var(--sy-tx);
    }
  }

  .sy-cmp__notes summary:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sy-cmp__notes summary::after {
      transition: none;
    }
  }

  .sy-cmp__notes ol {
    margin: 0;
    padding-block-end: 4px;
    padding-inline-start: 16px;
  }

  .sy-cmp__notes li + li {
    margin-top: 6px;
  }

  .sy-cmp__notes a {
    color: var(--sl-color-text-accent);
  }

  .sy-cmp__notes li:target {
    color: var(--sy-tx);
  }

  .sy-cmp__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
