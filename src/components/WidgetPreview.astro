---
import { manifestCard } from '../lib/widget-manifest';
import { CARD_H, RADIUS, widgetFit } from '../lib/widget-fit';

interface Props {
  type: string;
  file: string;
  id: string;
  size?: 'small' | 'medium';
  card?: 'dark' | 'graphite' | 'light' | 'translucent' | null;
  title: string;
  caption?: string;
}

const { type, file, id, size = 'small', card = null, title, caption } = Astro.props;
const declared = manifestCard(type, file);

const { w, frameStyle, zoom } = widgetFit(size);

const src = `/widgets/${type}/${file}?id=${encodeURIComponent(id)}&size=${size}&lang=en`;
---

<figure class="wpv">
  <div class="wpv__mat">
    <div
      class="wpv__card"
      data-card={card ?? declared.card ?? undefined}
      data-appearance={declared.appearance}
      style={`width:${w}px;height:${CARD_H}px;border-radius:${RADIUS}px;`}
    >
      <iframe
        src={src}
        title={title}
        aria-label={title}
        loading="lazy"
        scrolling="no"
        style={frameStyle}
        data-zoom={zoom}
      ></iframe>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import '../lib/widget-zoom';
</script>
