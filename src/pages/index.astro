      padding:0 10px 0 16px;border-radius:20px;background:rgba(118,118,128,.24);color:var(--accent);font:inherit;letter-spacing:inherit;
      cursor:pointer;transition:background .15s ease}
    .pop::after{content:'';position:absolute;left:0;right:0;top:50%;height:44px;transform:translateY(-50%)}
