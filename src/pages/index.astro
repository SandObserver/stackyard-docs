    <script is:inline>
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* The phone grid is fluid, the widget documents render on a fixed 170px canvas.
   Scale them from the card the grid actually produced. */
const demoScreen = document.querySelector('.screen-inner');
const phoneDemo = matchMedia('(max-width:768px)');
function fitDemoWidgets() {
  if (!demoScreen) return;
  if (!phoneDemo.matches) {
    demoScreen.style.removeProperty('--sc');
    demoScreen.style.removeProperty('--ws');
    demoScreen.style.removeProperty('--nps');
    return;
  }
  const screenW = demoScreen.clientWidth;
  if (screenW) demoScreen.style.setProperty('--sc', String(screenW / 393));
  const card = demoScreen.querySelector('.wcell');
  const w = card ? card.getBoundingClientRect().width : 0;
  if (w) demoScreen.style.setProperty('--ws', String(w / 170));
  const glass = demoScreen.querySelector('.np');
  if (glass && glass.clientWidth) {
    demoScreen.style.setProperty('--nps', String(glass.clientWidth / 170));
  }
}
fitDemoWidgets();
addEventListener('resize', fitDemoWidgets);
phoneDemo.addEventListener('change', fitDemoWidgets);

if (reduced) {
  const strip = document.querySelector('.marquee');
  if (strip) strip.tabIndex = 0;
}

if (!reduced) {
  const jf = document.getElementById('jellyfinCount');
  const sr = document.getElementById('seerrCount');
  const srcs = document.querySelectorAll('[data-live-seerr]');
  setInterval(() => {
    const a = Math.max(1, 2 + Math.round((Math.random() - 0.5) * 2));
    const b = Math.max(1, 7 + Math.round((Math.random() - 0.5) * 2));
    if (jf) jf.textContent = a;
    if (sr) sr.textContent = b;
    srcs.forEach(n => { n.textContent = b; });
  }, 3400);
}
