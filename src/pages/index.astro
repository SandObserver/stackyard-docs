      <div class="fvis">
        <div class="langs">
          <span class="lang">English</span>
          <span class="lang">فارسی <b>RTL</b></span>
          <span class="lang">简体中文</span>
          <span class="lang">Español</span>
          <span class="lang">Deutsch</span>
          <span class="lang">Français</span>
        </div>
      </div>
