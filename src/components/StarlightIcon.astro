---
import Original from 'virtual:starlight-original-icon';
import { inlineIcon } from '../lib/icon-set';
import { STARLIGHT_ICON_MAP } from '../lib/starlight-icon-map';

interface Props {
  name: string;
  label?: string;
  color?: string;
  size?: string;
  class?: string;
}

const { name, label, size = '1em', color } = Astro.props;
const mapped = STARLIGHT_ICON_MAP[name];
const body = mapped ? await inlineIcon(mapped.id, mapped.transform) : null;
const a11yAttrs = label ? ({ 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
---

{
  body ? (
    <svg {...a11yAttrs} class={Astro.props.class} width="16" height="16" viewBox="0 0 24 24" set:html={body} />
  ) : (
    <Original {...(Astro.props as any)} />
  )
}

<style define:vars={{ 'sl-icon-color': color, 'sl-icon-size': size }}>
  @layer starlight.components {
    svg {
      color: var(--sl-icon-color);
      font-size: var(--sl-icon-size, 1em);
      width: 1em;
      height: 1em;
    }
  }
</style>
