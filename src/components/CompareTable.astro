---
interface Row {
  label: string;
  values: [string, string, string, string];
  /* 1-based index into `footnotes`, marked on the Stackyard cell. */
  cellNote?: number;
  /* 1-based index into `footnotes`, marked on the row label. */
  labelNote?: number;
}

interface Props {
  rows: Row[];
  rivals: string[];
  /* Rendered as HTML so a note can link. Authored here, never user input. */
  footnotes: string[];
}

const { rows, rivals, footnotes } = Astro.props;
const names = ['Stackyard', ...rivals];
---

<div class="sy-cmp not-content">
  <div class="sy-cmp__card">
    <table class="sy-cmp__t">
      <caption class="sy-cmp__sr">Stackyard compared with {rivals.join(', ')}</caption>
      <thead>
        <tr>
          <th scope="col"><span class="sy-cmp__sr">Feature</span></th>
          <th scope="col" class="sy-cmp__own">
            <img
              class="sy-cmp__logo sy-cmp__logo--light"
              src="/img/stackyard-wordmark-light-b3140d1e.svg"
              alt="Stackyard"
              width="100"
              height="22"
            />
            <img
              class="sy-cmp__logo sy-cmp__logo--dark"
              src="/img/stackyard-wordmark-dark-4680834d.svg"
              alt="Stackyard"
              width="100"
              height="22"
            />
          </th>
          {rivals.map((name) => <th scope="col">{name}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">
              {row.label}
              {row.labelNote && (
                <a class="sy-cmp__mark" href={`#sy-fn-${row.labelNote}`}>
                  <sup>{row.labelNote}</sup>
                  <span class="sy-cmp__sr">See note {row.labelNote}</span>
                </a>
              )}
            </th>
            {row.values.map((value, i) => (
              <td class={i === 0 ? 'sy-cmp__own' : undefined}>
                {value}
                {i === 0 && row.cellNote && (
                  <a class="sy-cmp__mark" href={`#sy-fn-${row.cellNote}`}>
                    <sup>{row.cellNote}</sup>
                    <span class="sy-cmp__sr">See note {row.cellNote}</span>
                  </a>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="sy-cmp__list">
    {rows.map((row, g) => (
      <section class="sy-cmp__group" aria-labelledby={`sy-cmp-g${g}`}>
        <p class="sy-cmp__gh" id={`sy-cmp-g${g}`}>
          {row.label}
          {row.labelNote && (
            <a class="sy-cmp__mark" href={`#sy-fn-${row.labelNote}`}>
              <sup>{row.labelNote}</sup>
              <span class="sy-cmp__sr">See note {row.labelNote}</span>
            </a>
          )}
        </p>
        <dl class="sy-cmp__rows">
          {row.values.map((value, i) => (
            <div class:list={['sy-cmp__row', { 'sy-cmp__own': i === 0 }]}>
              <dt>{names[i]}</dt>
              <dd>
                {value}
                {i === 0 && row.cellNote && (
                  <a class="sy-cmp__mark" href={`#sy-fn-${row.cellNote}`}>
                    <sup>{row.cellNote}</sup>
                    <span class="sy-cmp__sr">See note {row.cellNote}</span>
                  </a>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>

  <ol class="sy-cmp__notes">
    {footnotes.map((text, i) => <li id={`sy-fn-${i + 1}`} set:html={text} />)}
  </ol>
</div>

<style>
  .sy-cmp {
    container-type: inline-size;
    margin: 20px 0 24px;
  }

  .sy-cmp__card {
    background: var(--sy-card);
    border-radius: 22px;
    overflow: hidden;
  }

  .sy-cmp__t {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 15px;
    line-height: 1.3333;
    letter-spacing: -0.0153em;
  }

  .sy-cmp__t th,
  .sy-cmp__t td {
    position: relative;
    padding: 14px 10px;
    border: 0;
    background: transparent;
    text-align: center;
    vertical-align: middle;
  }

  .sy-cmp__t thead th {
    padding-block: 16px 10px;
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    font-weight: 600;
    color: var(--sy-dim);
    vertical-align: bottom;
  }

  .sy-cmp__t tbody th {
    width: 30%;
    padding-inline-start: 16px;
    text-align: start;
    font-size: 15px;
    letter-spacing: -0.0153em;
    font-weight: 400;
    color: var(--sy-tx);
  }

  .sy-cmp__t td {
    color: var(--sy-dim);
  }

  .sy-cmp__t .sy-cmp__own {
    background: color-mix(in srgb, var(--sy-accent) 10%, transparent);
    color: var(--sy-tx);
    font-weight: 600;
  }

  .sy-cmp__t thead .sy-cmp__own {
    border-start-start-radius: 16px;
    border-start-end-radius: 16px;
  }

  .sy-cmp__t tbody tr:last-child .sy-cmp__own {
    border-end-start-radius: 16px;
    border-end-end-radius: 16px;
  }

  .sy-cmp__t tbody tr + tr > *::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--sy-row-sep);
  }

  .sy-cmp__t tbody tr + tr > th::before {
    inset-inline-start: 16px;
  }

  .sy-cmp__t tbody tr + tr > :last-child::before {
    inset-inline-end: 16px;
  }

  .sy-cmp__logo {
    display: block;
    width: 100px;
    height: auto;
    margin: 0 auto;
  }

  .sy-cmp__logo--dark,
  :root[data-theme='dark'] .sy-cmp__logo--light {
    display: none;
  }

  :root[data-theme='dark'] .sy-cmp__logo--dark {
    display: block;
  }

  .sy-cmp__list {
    display: none;
  }

  .sy-cmp__group + .sy-cmp__group {
    margin-top: 18px;
  }

  .sy-cmp__gh {
    margin: 0;
    padding: 0 16px 6px;
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    font-weight: 600;
    color: var(--sy-dim);
  }

  .sy-cmp__rows {
    margin: 0;
    background: var(--sy-card);
    border-radius: 22px;
    overflow: hidden;
  }

  .sy-cmp__row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 11px 16px;
    font-size: 15px;
    line-height: 1.3333;
    letter-spacing: -0.0153em;
  }

  .sy-cmp__row + .sy-cmp__row::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 16px;
    height: 1px;
    background: var(--sy-row-sep);
  }

  .sy-cmp__row dt {
    color: var(--sy-tx);
  }

  .sy-cmp__row dd {
    margin: 0;
    color: var(--sy-dim);
    text-align: end;
  }

  .sy-cmp__row.sy-cmp__own {
    background: color-mix(in srgb, var(--sy-accent) 10%, transparent);
  }

  .sy-cmp__row.sy-cmp__own :is(dt, dd) {
    color: var(--sy-tx);
    font-weight: 600;
  }

  @container (max-width: 520px) {
    .sy-cmp__card {
      display: none;
    }
    .sy-cmp__list {
      display: block;
    }
  }

  .sy-cmp__mark {
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }

  .sy-cmp__mark sup {
    font-size: 11px;
    line-height: 1;
    padding-inline-start: 2px;
  }

  .sy-cmp__mark:hover sup {
    text-decoration: underline;
  }

  .sy-cmp__notes {
    margin: 14px 0 0;
    padding-inline-start: 16px;
    font-size: 13px;
    line-height: 1.3846;
    letter-spacing: -0.0062em;
    color: var(--sy-dim);
  }

  .sy-cmp__notes li + li {
    margin-top: 6px;
  }

  .sy-cmp__notes a {
    color: var(--sl-color-text-accent);
  }

  .sy-cmp__notes li:target {
    color: var(--sy-tx);
  }

  .sy-cmp__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
