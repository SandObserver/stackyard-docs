    <script is:inline>
/* The phone grid is fluid, the widget documents render on a fixed 170px canvas.
   Scale them from the card the grid actually produced. */
const demoScreen = document.querySelector('.screen-inner');
const phoneDemo = matchMedia('(max-width:768px)');
function fitDemoWidgets() {
  if (!demoScreen) return;
  if (!phoneDemo.matches) {
    demoScreen.style.removeProperty('--sc');
    demoScreen.style.removeProperty('--ws');
    demoScreen.style.removeProperty('--nps');
    return;
  }
  const screenW = demoScreen.clientWidth;
  if (screenW) demoScreen.style.setProperty('--sc', String(screenW / 393));
  /* Measure after --sc lands. The grid resizes with it. Both reads must come
     before both writes, or each write forces another layout pass. */
  const card = demoScreen.querySelector('.wcell');
  const glass = demoScreen.querySelector('.np');
  const wide = demoScreen.querySelector('.wmed');
  const cardW = card ? card.getBoundingClientRect().width : 0;
  const glassW = glass ? glass.clientWidth : 0;
  const wideBox = wide ? wide.getBoundingClientRect() : null;
  if (cardW) demoScreen.style.setProperty('--ws', String(cardW / 170));
  if (glassW) demoScreen.style.setProperty('--nps', String(glassW / 170));
  if (wideBox && wideBox.height) {
    const frame = wide.querySelector('iframe');
    const k = wideBox.height / 170;
    frame.style.width = `${wideBox.width / k}px`;
    frame.style.transform = `scale(${k})`;
  }
}
fitDemoWidgets();
if (demoScreen) new ResizeObserver(fitDemoWidgets).observe(demoScreen);
phoneDemo.addEventListener('change', fitDemoWidgets);
    </script>
    <script is:inline>
{
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  for (const orbit of document.querySelectorAll('a .orbit')) {
    const link = orbit.closest('a');
    let run = null;
    const spin = () => {
      if (run || reduce.matches) return;
      run = orbit.animate(
        [{ transform: 'rotate(0deg)' }, { transform: 'rotate(360deg)' }],
        { duration: 1000, easing: 'cubic-bezier(.65,0,.35,1)' }
      );
      run.onfinish = run.oncancel = () => (run = null);
    };
    link.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') spin(); });
    link.addEventListener('focus', () => { try { if (link.matches(':focus-visible')) spin(); } catch {} });
  }
}
    </script>
