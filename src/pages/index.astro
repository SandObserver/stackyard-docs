              <span class="aicon aicon-wg" style="background:#3A3A3C"><svg viewBox="0 0 24 24" aria-hidden="true"><defs><mask id="lp-nowplaying-m" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect width="24" height="24" fill="#fff"/><path d="M10 8v8l6-4z" fill="#000" stroke="#000" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></mask></defs><g mask="url(#lp-nowplaying-m)"><rect x="3" y="3" width="18" height="18" rx="4" fill="currentColor"/></g><g><path d="M10 8v8l6-4z" class="sy-a sy-as" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g></svg></span>
