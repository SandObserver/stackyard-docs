---
import Default from '@astrojs/starlight/components/Head.astro';
import { iconMaskUri } from '../lib/icon-set';
import { SPECULATION_RULES } from '../lib/speculation.mjs';

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const { entry, head } = Astro.locals.starlightRoute;
for (const tag of head) if (tag.attrs?.property === 'og:locale') tag.attrs.content = 'en_US';
const docTitle = head.find((tag) => tag.tag === 'title')?.content;
const pageTitle = entry.data.title;
const pageDescription = entry.data.description ?? '';

const crumbs = [{ name: 'Stackyard', item: `${site}/` }];
if (Astro.url.pathname !== '/docs/') crumbs.push({ name: 'Docs', item: `${site}/docs/` });
crumbs.push({ name: pageTitle, item: new URL(Astro.url.pathname, `${site}/`).href });

const MASKS = { search: 'search', close: 'close', check: 'check', page: 'docs' };
const maskVars = (
  await Promise.all(Object.entries(MASKS).map(async ([name, id]) => [name, await iconMaskUri(id)]))
)
  .filter(([, uri]) => uri)
  .map(([name, uri]) => `--sy-mask-${name}:url("${uri}");`)
  .join('');

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.item,
  })),
};
---

<Default {...Astro.props}><slot /></Default>
<meta name="color-scheme" content="light dark" />
<script is:inline>
  (() => {
    const t = localStorage.getItem('starlight-theme');
    if (t === 'light' || t === 'dark') document.querySelector('meta[name="color-scheme"]').content = t;
  })();
</script>
<script type="speculationrules" is:inline set:html={SPECULATION_RULES} />
<meta name="twitter:title" content={docTitle ?? `${pageTitle} | Stackyard`} />
{pageDescription && <meta name="twitter:description" content={pageDescription} />}
<meta property="og:image:alt" content="The Stackyard dashboard, showing app tiles and widgets" />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
{maskVars && <style is:inline set:html={`:root{${maskVars}}`} />}

<script>
  /* A table wider than its column scrolls. A scroll container that a keyboard
     cannot reach strands the hidden columns. */
  const sync = (box: HTMLElement) => {
    if (box.scrollWidth > box.clientWidth + 1) {
      box.tabIndex = 0;
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', 'Scrollable table');
    } else {
      box.removeAttribute('tabindex');
      box.removeAttribute('role');
      box.removeAttribute('aria-label');
    }
  };

  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) sync(entry.target as HTMLElement);
  });

  for (const box of document.querySelectorAll<HTMLElement>('.sy-tscroll')) {
    sync(box);
    observer.observe(box);
  }

  /* Expressive Code makes a scrolling code block a region without a name. */
  const blocks = [...document.querySelectorAll<HTMLElement>('.expressive-code pre')];
  const label = new MutationObserver(() => {
    blocks.forEach((pre, i) => {
      if (pre.getAttribute('role') !== 'region') pre.removeAttribute('aria-label');
      else pre.setAttribute('aria-label', `Code example ${i + 1}${pre.dataset.language ? `, ${pre.dataset.language}` : ''}`);
    });
  });
  for (const pre of blocks) label.observe(pre, { attributes: true, attributeFilter: ['role'] });
</script>
<noscript><style is:inline>.sy-filter{display:none}</style></noscript>
<script>
  const applyThemeColor = () => {
    const color = document.documentElement.dataset.theme === 'light' ? '#f2f2f7' : '#000000';
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) meta.content = color;
    const stored = localStorage.getItem('starlight-theme');
    const scheme = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
    if (scheme) scheme.content = stored === 'light' || stored === 'dark' ? stored : 'light dark';
  };
  new MutationObserver(applyThemeColor).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  applyThemeColor();

  window.addEventListener(
    'keydown',
    (e) => {
      const isSearchKey = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      if (isSearchKey || e.key === 'Escape') document.documentElement.setAttribute('data-sy-key', '');
    },
    true,
  );
  window.addEventListener('pointerdown', () => document.documentElement.removeAttribute('data-sy-key'), true);
</script>
<script src="../scripts/motion.ts"></script>
<script src="../scripts/page-filter.ts"></script>
